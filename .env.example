# Copy to .env. Existing environment variables take precedence.
APP_ORIGIN=http://127.0.0.1:8000
BUILDERP_DATA_DIR=./data
# Used to encrypt the owner's saved Gemini key. Keep this value stable.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SETTINGS_SECRET=
# Optional: if empty, a private persistent session secret is generated in data/.
SECRET_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Optional alternative to saving a key through Settings.
GEMINI_API_KEY=
# Leave R2 settings empty for private local file storage.
# For an existing R2 bucket, set all five values and install requirements.txt.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Remote database: set BOTH to use Turso; empty means local SQLite only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel requires a stable SECRET_KEY; never leave it empty there.
# Preserve SETTINGS_SECRET from the existing app to decrypt saved Gemini keys.
# Set APP_ORIGIN to the exact deployment URL, including https:// (no trailing /).
