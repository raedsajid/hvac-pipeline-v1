{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{python_tests/**,data/**,.venv/**,*.zip,detection-reference/**}"
    }
  },
  "headers": [{"source":"/static/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}]
}
